.vercel
.gradle/
.android-home/
.tmp-gradle-build/
.idea/
build/
app/build/
**/build/
# Keep desktop brand icons tracked (electron-builder + splash)
!desktop/build/
!desktop/build/icon.ico
!desktop/build/icon.png
!desktop/build/splash-mark.png
# Gateway tray icons (electron-builder + system tray)
!gateway-tray/build/
!gateway-tray/build/**
# Never commit Electron build output (huge); ship installer via downloads/
gateway-tray/dist/
desktop/dist/
desktop/dist-*/
*.apk
*.aar
*.exe
# Local plug-and-play builds (not the public site) — keep README only
local-builds/*
!local-builds/README.md
# Public homepage download hub (stable names — must be deployable)
!downloads/
!downloads/**
!downloads/RestroSuite-Android.apk
!downloads/*.pdf
!downloads/manifest.json
!downloads/README.md

dashboard-phase2-restore.zip
local.properties
.DS_Store

# Android release signing — NEVER commit keystores or signing credentials
*.jks
*.keystore
android-app/gradle.properties


# Cloudflare / static publish output (built on CI)
publish-static/

# Node
node_modules/
**/node_modules/
node_modules_old/
.npm-cache/
node-portable/
node.zip

# Nested deploy mirror (optional; root tree is source of truth).
# Populate with: powershell -File ./sync-codearc.ps1
# Do not track as a git submodule — it causes permanent drift.
codearc-restrosuite/
codearc-restrosuite-1/

# WhatsApp session files (never commit these)
.wwebjs_auth/
.wwebjs_auth (1)/
.wwebjs_cache/

# Sensitive config (contains passwords / secrets)
email-config.json
.env
.env.*
!*.env.example
# Belt-and-suspenders: .env.local was force-added historically and may
# still be tracked despite the .env.* glob above. Keep it explicit.
/.env.local

# Sample/dev files
sample_dashboard.css
sample_dashboard.html

# Kombai tool files
.kombai/

# Python cache
__pycache__/
*.pyc

# Local Supabase CLI executables and test results
supabase.exe
supabase-go.exe
res.txt
.aider*

# Logs and temporary files
*.log
test_sec.log
test_sec_utf8.log
.thumbnail
uploads/
backups/
temp_backup/

# Windows reserved device name (created accidentally by redirect errors)
nul

# Agent files
.gemini/
.env*

# License signing (never commit private keys)
scripts/.license-signing-key.dev.b64
*.license-key
LICENSE_PRIVATE_KEY_KEEP_SECRET.txt

# Secrets / private keys � never commit
*PRIVATE_KEY*
*private*key*
*.pem
LICENSE_PRIVATE_KEY*
.env
.env.*
!.env.example


test-results/
playwright-report/

# Local audit, extraction, and packaging workspaces
scratch/
scratch-*/
gateway-hf/_space_build/
eslint-report*.json
assets/dist/_critical-src*.js
*.bak
.vscode/

# Release binaries belong in GitHub Releases, not source history
downloads/*.dmg
downloads/desktop/*.exe
downloads/desktop/*.blockmap


# Secrets that must never be committed
scripts/.billing-secrets.env
scripts/.email-relay.env

# Windows shell junk
*.desktop.ini
desktop.ini

# Android release signing material — never commit
android-app/release.jks
android-app/*.jks
android-app/keystore.properties

# Android gradle temp build dirs
android-app/.tmp-gradle-build*
