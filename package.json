{
  "name": "codearc-restrosuite",
  "version": "2.0.0",
  "private": true,
  "description": "RestroSuite zero-cost restaurant SaaS on Vercel and Supabase, with an optional WhatsApp gateway add-on.",
  "scripts": {
    "start": "node whatsapp-gateway.js",
    "start:gateway": "node whatsapp-gateway.js",
    "check:free-tier": "node scripts/check-free-tier.cjs",
    "build:critical": "node scripts/build-critical.cjs",
    "pretest": "node scripts/build-critical.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node --test tests/e2e-smoke.test.cjs",
    "test:e2e:browser": "npx playwright test",
    "test:e2e:browser:install": "npx playwright install chromium",
    "check:role-defaults": "node scripts/check-role-defaults.cjs",
    "lint": "eslint \"assets/modules/**/*.js\" \"src/dashboard/**/*.js\" \"gateway-modules/**/*.js\" \"scripts/**/*.cjs\" whatsapp-gateway.js ngrok-service.js middleware.js service-worker.js 2>&1 || echo \"Lint completed with warnings/errors (see above)\"",
    "lint:fix": "eslint --fix \"assets/modules/**/*.js\" \"src/dashboard/**/*.js\" \"gateway-modules/**/*.js\" \"scripts/**/*.cjs\" whatsapp-gateway.js ngrok-service.js middleware.js service-worker.js 2>&1 || echo \"Lint-fix completed (see above)\"",
    "lint:ci": "eslint \"assets/modules/**/*.js\" \"src/dashboard/**/*.js\" \"gateway-modules/**/*.js\" \"scripts/**/*.cjs\" whatsapp-gateway.js ngrok-service.js middleware.js service-worker.js",
    "perf:vitals": "node scripts/measure-web-vitals.cjs",
    "perf:ci": "node scripts/perf-ci.cjs",
    "perf:prod": "node scripts/measure-web-vitals.cjs https://restrosuite.codearc.co.in/index.html?home=1 https://restrosuite.codearc.co.in/login.html",
    "a11y:ci": "node scripts/a11y-ci.cjs",
    "loadtest": "node scripts/loadtest.cjs",
    "check": "node scripts/check-role-defaults.cjs && node scripts/check-project.cjs && node scripts/check-free-tier.cjs",
    "check:launch": "node scripts/check-launch.cjs",
    "check:prod-assets": "node scripts/check-prod-assets.cjs",
    "check:pwa": "node scripts/ensure-pwa-assets.cjs",
    "sync:icons": "node scripts/sync-brand-icons.cjs",
    "hash:superadmin": "node scripts/hash-superadmin-password.cjs",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "drill:backup": "node scripts/backup-restore-drill.cjs",
    "drill:backup:create": "node scripts/backup-restore-drill.cjs --create",
    "drill:backup:structure": "node scripts/backup-restore-drill.cjs --structure",
    "bump:sw-version": "node scripts/bump-sw-version.cjs",
    "bump:content-version": "node scripts/bump-content-version.cjs",
    "sync:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./sync-assets.ps1",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android.ps1",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "sync:downloads": "node scripts/sync-downloads.cjs",
    "build:content-manifest": "node scripts/build-content-manifest.cjs",
    "publish:release": "node scripts/publish-github-release.cjs",
    "release:binaries": "node scripts/sync-downloads.cjs && node scripts/publish-github-release.cjs && node scripts/sync-downloads.cjs",
    "pages:build": "node scripts/bump-content-version.cjs --ci && node scripts/build-critical.cjs && node scripts/build-content-manifest.cjs && node scripts/build-pages.cjs && node scripts/minify-assets.cjs",
    "minify:assets": "node scripts/minify-assets.cjs",
    "vercel-build": "npm run pages:build"
  },
  "engines": {
    "node": ">=20 <26"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.107.0",
    "@whiskeysockets/baileys": "6.7.23",
    "archiver": "7.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "lines-and-columns": "2.0.4",
    "nodemailer": "9.0.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "razorpay": "2.9.8",
    "unzipper": "0.12.3",
    "ws": "8.21.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "hyperid": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "autocannon": "8.0.0",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "eslint": "10.6.0",
    "jsdom": "29.1.1"
  }
}
