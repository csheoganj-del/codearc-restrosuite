{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "publish-static",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.counterapi.dev https://cdnjs.cloudflare.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com; media-src 'self' data: blob:; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/RestroSuite-Windows-Setup.exe",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-Windows-Setup.exe",
      "permanent": false
    },
    {
      "source": "/downloads/RestroSuite-Windows-Portable.exe",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-Windows-Portable.exe",
      "permanent": false
    },
    {
      "source": "/downloads/desktop/RestroSuite-2.0.5-x64.exe",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-2.0.5-x64.exe",
      "permanent": false
    },
    {
      "source": "/downloads/desktop/RestroSuite-Desktop-2.0.5-portable.exe",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-Desktop-2.0.5-portable.exe",
      "permanent": false
    },
    {
      "source": "/downloads/RestroSuite-Mac-AppleSilicon.dmg",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-Mac-AppleSilicon.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/RestroSuite-Mac-Intel.dmg",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-Mac-Intel.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/RestroSuite-Android.apk",
      "destination": "https://github.com/csheoganj-del/restrosuite-downloads/releases/download/v2.0.5/RestroSuite-Android.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/go",
      "destination": "/go.html"
    },
    {
      "source": "/wa",
      "destination": "/go.html"
    },
    {
      "source": "/start",
      "destination": "/go.html"
    },
    {
      "source": "/bill/:tenantSlug/:billNo*",
      "destination": "/bill.html?slug=:tenantSlug&no=:billNo"
    },
    {
      "source": "/bill",
      "destination": "/bill.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/install",
      "destination": "/install.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/order",
      "destination": "/order.html"
    },
    {
      "source": "/qr-order",
      "destination": "/qr-order.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/kds",
      "destination": "/kds.html"
    },
    {
      "source": "/tokens",
      "destination": "/tokens.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-policy.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    }
  ]
}
