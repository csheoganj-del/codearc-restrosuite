{
  "name": "restrosuite-gateway-tray",
  "productName": "RestroSuite Gateway",
  "version": "1.0.1",
  "private": true,
  "description": "System-tray controller for RestroSuite WhatsApp gateway + ngrok. Starts with Windows; close keeps it in tray.",
  "author": "RestroSuite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:local": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.restrosuite.gateway-tray",
    "productName": "RestroSuite Gateway",
    "copyright": "Copyright (c) 2026 RestroSuite",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "status.html",
      "build/icon.ico",
      "build/icon.png",
      "build/tray.ico",
      "build/tray.png",
      "build/tray-green-solid.png",
      "build/tray-green.png"
    ],
    "extraResources": [
      {
        "from": "build/tray.ico",
        "to": "tray/tray.ico"
      },
      {
        "from": "build/tray.png",
        "to": "tray/tray.png"
      },
      {
        "from": "build/tray-green-solid.png",
        "to": "tray/tray-green-solid.png"
      },
      {
        "from": "build/tray-green-solid.png",
        "to": "tray/icon-gateway.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RestroSuite-Gateway-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "RestroSuite-Gateway-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RestroSuite Gateway",
      "runAfterFinish": true,
      "artifactName": "RestroSuite-Gateway-${version}-Setup.${ext}"
    }
  }
}
