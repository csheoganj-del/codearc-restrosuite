# RestroSuite environment template
# Copy to .env.local and provide real values. Never commit .env.local.

# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPERADMIN_SESSION_SECRET=<random-64-byte-hex-secret>
PIN_RESET_CODE_HASH=<sha256-hex-of-reset-code>

# Offline licensing
LICENSE_SIGNING_KEY=<base64-pkcs8-private-key>
LICENSE_OFFLINE_WINDOW_DAYS=3

# Exact, comma-separated browser origins allowed to call Edge Functions
ALLOWED_ORIGIN=https://restrosuite.codearc.co.in
ALLOWED_ORIGINS=https://restrosuite.codearc.co.in,https://codearc-restrosuite.vercel.app

# WhatsApp Gateway
WHATSAPP_GATEWAY_URL=
NGROK_DOMAIN=
NGROK_GATEWAY_URL=
GATEWAY_PORT=3000
GATEWAY_TOKEN=
WHATSAPP_GATEWAY_TOKEN=
SUPABASE_SERVICE_KEY=<service-role-key-for-gateway-storage>

# Gateway alerts
ADMIN_ALERT_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DESKTOP_ALERTS_ENABLED=true

# Razorpay Standard Checkout
# RAZORPAY_KEY_SECRET is server-only and must never enter browser code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional authenticated browser tests
# E2E_OUTLET_SLUG=
# E2E_USERNAME=
# E2E_PASSWORD=
# E2E_BASE_URL=https://restrosuite.codearc.co.in

# Android release signing (set in android-app/gradle.properties, which is ignored)
# RELEASE_STORE_FILE=../release.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
