{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    // ── Errors that indicate definite bugs ──────────────────────────────────
    "no-irregular-whitespace": "error",
    "no-unreachable": "error",
    "no-duplicate-case": "error",
    "no-undef": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "no-dupe-else-if": "error",
    "no-duplicate-imports": "error",
    "no-self-assign": "error",
    "no-self-compare": "error",
    "no-sparse-arrays": "error",
    "no-template-curly-in-string": "error",
    "no-unexpected-multiline": "error",
    "no-import-assign": "error",
    "use-isnan": "error",
    "valid-typeof": ["error", { "requireStringLiterals": true }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-loss-of-precision": "error",
    "no-promise-executor-return": "error",

    // ── Code quality — warn (fail CI on new violations, don't block old code) ─
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true,
        "caughtErrors": "none"
      }
    ],
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-extra-semi": "warn",
    "no-extra-boolean-cast": "warn",
    "no-useless-escape": "warn",
    "no-useless-return": "warn",
    "no-useless-concat": "warn",
    "no-useless-rename": "warn",

    // ── Best-practice enforcement ────────────────────────────────────────────
    // Prefer === over == to avoid type-coercion bugs
    "eqeqeq": ["error", "always", { "null": "ignore" }],

    // Require braces on all control-flow bodies to prevent dangling-else bugs
    "curly": ["error", "all"],

    // Disallow var — use const/let for block-scoped, predictable bindings
    "no-var": "error",

    // Prefer const where the binding is never reassigned
    "prefer-const": ["warn", { "destructuring": "any" }],

    // Avoid accidental globals: all variables must be declared
    "no-implicit-globals": "error",

    // Prevent accidental number → string type coercion in arithmetic
    "no-implicit-coercion": ["warn", { "boolean": false, "string": true, "number": true }],

    // Guard against calling eval() or Function() with a string argument
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",

    // Prevent extending native prototypes (breaks polyfill assumptions)
    "no-extend-native": "error",

    // Disallow reassigning function parameters (makes tracing data flow harder)
    "no-param-reassign": ["warn", { "props": false }],

    // Disallow console.log in production code (use a logger utility instead).
    // warn (not error) so existing gateway debug logs don't block CI.
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],

    // Disallow alert/confirm/prompt in browser code
    "no-alert": "warn",

    // Require default case in switch statements
    "default-case": "warn",

    // Disallow fallthrough in switch without explicit comment
    "no-fallthrough": "error",

    // Prevent return before variable declaration (temporal dead zone confusion)
    "no-use-before-define": ["warn", { "functions": false, "classes": true, "variables": true }],

    // Radix: always supply the base argument to parseInt()
    "radix": "error",

    // Yoda conditions are confusing: prefer `x === 1` over `1 === x`
    "yoda": ["warn", "never"],

    // ── Async / Promise safety ───────────────────────────────────────────────
    "no-async-promise-executor": "error",
    "no-await-in-loop": "warn",
    "require-atomic-updates": "warn",

    // ── Style consistency (enforced but not blocking) ─────────────────────
    "no-trailing-spaces": "warn",
    "no-multiple-empty-lines": ["warn", { "max": 3, "maxEOF": 1 }],
    "eol-last": ["warn", "always"],
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true, "allowTemplateLiterals": false }]
  },

  // Shared globals defined by the RestroSuite runtime (IIFEs attached to window)
  "globals": {
    "RS_API": "readonly",
    "RS_AUTH": "readonly",
    "RSActionFeedback": "readonly",
    "RSLicense": "readonly",
    "RSSkel": "readonly",
    "supabase": "readonly",
    "CONFIG": "readonly"
  },

  "overrides": [
    {
      // Gateway and Node scripts — allow console freely (it IS the logger there)
      "files": [
        "whatsapp-gateway.js",
        "gateway-modules/**/*.js",
        "scripts/**/*.cjs",
        "scripts/**/*.js",
        "api/**/*.js",
        "tests/**/*.cjs"
      ],
      "rules": {
        "no-console": "off",
        "no-var": "warn",
        "no-param-reassign": "off"
      }
    },
    {
      // Test files — relax a few rules that are intentionally violated in tests
      "files": ["tests/**/*.cjs", "tests/**/*.js"],
      "rules": {
        "no-unused-vars": "off",
        "prefer-const": "off"
      }
    },
    {
      // ES module API routes (Vercel serverless — use ESM export default)
      "files": ["api/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      // Edge middleware (Vercel Edge Runtime — ESM + Next.js globals)
      "files": ["middleware.js"],
      "parserOptions": {
        "sourceType": "module"
      },
      "globals": {
        "crypto": "readonly",
        "Headers": "readonly",
        "Response": "readonly",
        "Request": "readonly",
        "fetch": "readonly"
      }
    }
  ]
}
